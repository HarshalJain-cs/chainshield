# ============================================================================
# ChainShield Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your values

# ────────────────────────────────────────────────────────────────────────────
# CONVEX (Backend Database)
# ────────────────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.convex.dev
# 1. Create a new project
# 2. Run `npx convex dev` to get your deployment URL
# 3. Copy the values below

VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment-name

# ────────────────────────────────────────────────────────────────────────────
# THIRDWEB (Wallet Connection & Social Login)
# ────────────────────────────────────────────────────────────────────────────
# Get your Client ID from: https://thirdweb.com/dashboard
# 1. Create free account
# 2. Create new project
# 3. Copy Client ID
# Features: Google login, Apple, Facebook, Email/Phone + traditional wallets

VITE_THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here

# ────────────────────────────────────────────────────────────────────────────
# BLOCKCHAIN RPC (Optional - for better performance)
# ────────────────────────────────────────────────────────────────────────────
# Alchemy (Recommended): https://www.alchemy.com
# Infura (Alternative): https://infura.io

# VITE_ALCHEMY_ID=your_alchemy_api_key
# VITE_INFURA_ID=your_infura_api_key

# ────────────────────────────────────────────────────────────────────────────
# APP CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────
VITE_APP_NAME=ChainShield
VITE_APP_URL=http://localhost:5173

# Production URL (when deploying)
# VITE_APP_URL=https://your-domain.com
