# ============================================================================
# ChainShield Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your values

# ────────────────────────────────────────────────────────────────────────────
# CONVEX (Backend Database)
# ────────────────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.convex.dev
# 1. Create a new project
# 2. Run `npx convex dev` to get your deployment URL
# 3. Copy the values below

VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment-name

# ────────────────────────────────────────────────────────────────────────────
# THIRDWEB (Wallet Connection & Social Login)
# ────────────────────────────────────────────────────────────────────────────
# Get your Client ID from: https://thirdweb.com/dashboard
# 1. Create free account → New Project → Copy Client ID (free)
# Features: Google, Apple, Facebook, Email, Phone + MetaMask, Coinbase, WalletConnect

VITE_THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here

# ────────────────────────────────────────────────────────────────────────────
# BLOCKCHAIN RPC (Optional - for better performance)
# ────────────────────────────────────────────────────────────────────────────
# Alchemy (Recommended): https://www.alchemy.com

# VITE_ALCHEMY_ID=your_alchemy_api_key

# ────────────────────────────────────────────────────────────────────────────
# APP CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────
VITE_APP_NAME=ChainShield
VITE_APP_URL=http://localhost:5173

# Production URL (when deploying)
# VITE_APP_URL=https://your-domain.com

# ────────────────────────────────────────────────────────────────────────────
# APP MODE
# demo  = simulated flows, no blockchain/wallet required
# live  = real blockchain calls on Sepolia (requires contracts deployed)
# ────────────────────────────────────────────────────────────────────────────
VITE_MODE=demo

# ────────────────────────────────────────────────────────────────────────────
# SMART CONTRACT ADDRESSES (Phase 2 — leave commented until deployed)
# Deploy via: npx thirdweb deploy  →  Ethereum Sepolia testnet
# ────────────────────────────────────────────────────────────────────────────
# VITE_POLICY_MANAGER_ADDRESS=0x...
# VITE_INSURANCE_POOL_ADDRESS=0x...
# VITE_CLAIMS_PROCESSOR_ADDRESS=0x...
# VITE_PREMIUM_VAULT_ADDRESS=0x...
# VITE_CST_TOKEN_ADDRESS=0x...
# VITE_LP_TOKEN_ADDRESS=0x...
# VITE_GOVERNOR_ADDRESS=0x...
# VITE_CHAINLINK_VERIFIER_ADDRESS=0x...

# ────────────────────────────────────────────────────────────────────────────
# CONVEX SERVER-SIDE SECRETS (Phase 3+)
# Set via Convex dashboard or: npx convex env set KEY=value
# Do NOT prefix with VITE_ — these never reach the browser
# ────────────────────────────────────────────────────────────────────────────
# PINATA_JWT=your_pinata_jwt_here             (IPFS uploads)
# PINATA_GATEWAY=https://gateway.pinata.cloud
# ALCHEMY_WEBHOOK_SECRET=xxx                  (event indexing)
# CHAINLINK_SUBSCRIPTION_ID=xxx              (Chainlink Functions oracle)
